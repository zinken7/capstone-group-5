# Local development values only. Do not reuse these credentials outside Docker Compose.
POSTGRES_DB=autonomous_mining
POSTGRES_USER=autonomous_mining
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432

BACKEND_PORT=3000
DATABASE_URL=postgresql://autonomous_mining:local_dev_password@localhost:5432/autonomous_mining

# The official postgis/postgis image is currently published for amd64.
# Docker Desktop can emulate this platform on Apple Silicon.
POSTGIS_PLATFORM=linux/amd64
