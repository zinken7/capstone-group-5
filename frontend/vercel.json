{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": { "main": false }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://capstone-group-5-api.vercel.app/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
